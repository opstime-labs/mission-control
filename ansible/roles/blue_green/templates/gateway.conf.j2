upstream mission_control_backend {
    # Dynamically toggled: 127.0.0.1:5001 (blue) or 127.0.0.1:5002 (green)
    server host.docker.internal:5001 max_fails=3 fail_timeout=5s;
    keepalive 32;
}

server {
    listen 80;
    server_name _;

    client_max_body_size 16M;

    location / {
        proxy_pass http://mission_control_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 2s;
        proxy_send_timeout 5s;
        proxy_read_timeout 5s;
    }

    location /health {
        proxy_pass http://mission_control_backend/health;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        access_log off;
    }
}