<Project>
  <PropertyGroup>
    <!-- ===================================================================== -->
    <!-- 1. COMPILER & RUNTIME BASELINE (.NET 10)                              -->
    <!-- ===================================================================== -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Controlled Goods Baseline: Zero Compiler Warning Tolerance -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- ===================================================================== -->
    <!-- 2. CODE ANALYSIS & SAST ENFORCEMENT                                   -->
    <!-- ===================================================================== -->
    <!-- .NET 10 SDK includes Microsoft.CodeAnalysis.NetAnalyzers out of the box -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- ===================================================================== -->
    <!-- 3. SUPPLY CHAIN GOVERNANCE & SECURITY AUDIT (NuGet SCA)               -->
    <!-- ===================================================================== -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>

    <!-- Promote all NuGet vulnerability advisories into hard build failures:   -->
    <!-- NU1901: Low, NU1902: Moderate, NU1903: High, NU1904: Critical         -->
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>

    <!-- Suppress HTTP warning strictly for internal lab Nexus proxy           -->
    <NoWarn>$(NoWarn);NU1803</NoWarn>

    <!-- ===================================================================== -->
    <!-- 4. AIR-GAPPED IMMUTABILITY & DETERMINISTIC RESTORES                   -->
    <!-- ===================================================================== -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Fail build immediately on package graph or hash drift during CI runs -->
    <RestoreLockedMode Condition="'$(ContinuousIntegrationBuild)' == 'true' Or '$(CI)' == 'true'">true</RestoreLockedMode>

    <!-- Bit-for-bit reproducible compilation across distributed agents        -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(ContinuousIntegrationBuild)' == 'true' Or '$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- ===================================================================== -->
    <!-- 5. DEFENCE / SIL RUNTIME CRASH DUMP HARDENING                         -->
    <!-- ===================================================================== -->
    <!-- Embed full debug symbols directly into the assembly for native        -->
    <!-- Linux coredump/GDB analysis without external .pdb distribution        -->
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>

    <!-- Prevent automatic assembly binding redirects in mission assemblies    -->
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>
</Project>