<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- 1. CLEAR all inherited machine/user global package sources -->
    <clear />
<!-- 2. ROUTE all package traffic strictly through Nexus nuget-group -->
    <!-- nuget-group serves both your internal packages (nuget-hosted) and cached proxies (nuget.org-proxy) -->
    <add key="Nexus-Homelab-Group" value="http://10.0.0.182:8081/repository/nuget-group/index.json" protocolVersion="3" />
  </packageSources>
<!-- 3. Package Source Mapping: Enforce exact routing (Zero-Trust Supply Chain) -->
  <packageSourceMapping>
    <packageSource key="Nexus-Homelab-Group">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
