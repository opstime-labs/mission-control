<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Framework and security properties are centralized in Directory.Build.props -->

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.31" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <Target Name="BuildNativeSensorHal" BeforeTargets="Build">
    <Exec Command="cmake -S $(MSBuildProjectDirectory)/../native -B $(IntermediateOutputPath)native-build -DCMAKE_BUILD_TYPE=$(Configuration) &amp;&amp; cmake --build $(IntermediateOutputPath)native-build --config $(Configuration)" />
    <Copy SourceFiles="$(IntermediateOutputPath)native-build/libsensor_hal.so" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyNativeSensorHalToPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(IntermediateOutputPath)native-build/libsensor_hal.so" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>