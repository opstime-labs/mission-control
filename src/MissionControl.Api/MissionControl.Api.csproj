<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Framework and security properties are centralized in Directory.Build.props -->

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.31" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

 <ItemGroup>
    <Content Include="$(IntermediateOutputPath)native-build/libsensor_hal.so">
      <Link>libsensor_hal.so</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="BuildNativeSensorHal" BeforeTargets="AssignTargetPaths">
    <Exec Command="cmake -S $(MSBuildProjectDirectory)/../native -B $(IntermediateOutputPath)native-build -DCMAKE_BUILD_TYPE=$(Configuration) &amp;&amp; cmake --build $(IntermediateOutputPath)native-build --config $(Configuration)" />
  </Target>

</Project>